---
const agentes = [
  { num: "#1", icon: "🩺", title: "Agente Nutri Clínico", desc: "Seu assistente de I.A para dúvidas gerais de Nutrição e suporte com casos clínicos." },
  { num: "#2", icon: "📊", title: "Interpretador de Exames", desc: "Mande os exames dos pacientes e eu vou analisar para você e te ajudar a interpretar com precisão." },
  { num: "#3", icon: "🥗", title: "Receitas Infinitas", desc: "Receitas baseadas na Metodologia STATUS FUNCIONAL™. Combino Lipídios Bioativos, Fitoquímicos e Probióticos para gerar, em segundos, receitas funcionais de verdade." },
  { num: "#4", icon: "🔍", title: "Agente Raio-X da Dieta", desc: "Cole o cardápio que você fez e receba uma análise fundamentada na biodisponibilidade dos nutrientes e encontre as carências nutricionais e pontos de melhoria da sua prescrição." },
  { num: "#5", icon: "💊", title: "Suplementação & Manipulados", desc: "Suplementos com base científica e manipulados exatos para a dieta e individualidade do seu paciente." },
  { num: "#6", icon: "🎓", title: "Mentor de Recém-Formados", desc: "Se formou agora e tá cheio de dúvidas? Vem cá que eu te ajudo a dar os primeiros passos com segurança!" },
  { num: "#7", icon: "🚀", title: "Agente de Posicionamento", desc: "Chegou a hora de desvendar esse mistério chamado 'posicionamento' e criar o seu da forma correta. Esse agente vai te guiar através de 7 etapas a construir seu posicionamento, oferta, bio, público-alvo e marketing." }
];
---
<section class="ia-section section-padding" id="agentes-ia">
  <div class="container">
    <div class="ia-wrapper glass-panel">
      <div class="ia-header">
        <div class="badge badge-gold">TECNOLOGIA EXCLUSIVA</div>
        <h2 class="ia-title">TENHA 7 ESPECIALISTAS DE I.A. À SUA DISPOSIÇÃO</h2>
        <p class="ia-subtitle">
          Prontos para pensar, analisar e responder como quem vive o consultório. O único sistema de inteligência artificial do Brasil exclusivo para nutricionistas.
        </p>
      </div>

      <div class="agentes-grid">
        {agentes.map(item => (
          <div class="agente-item">
            <div class="agente-header-box">
              <span class="agente-num">{item.num}</span>
              <div class="agente-icon">{item.icon}</div>
            </div>
            <div class="agente-info">
              <h4 class="agente-name">{item.title}</h4>
              <p class="agente-desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="prompts-box glass-panel">
        <div class="prompts-icon">🎁</div>
        <div class="prompts-content">
          <h3 class="prompts-title">BÔNUS ESPECIAL: +50 PROMPTS DE ALTA CONVERSÃO E GESTÃO</h3>
          <p class="prompts-desc">
            Receba um acervo validado de prompts prontos para copiar e colar: Follow Up de pacientes, Prescrição Avançada, Marketing Ético, Contratos, Roteiros de Anamnese, Gestão de Consultório e Controle Financeiro.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ia-wrapper {
    padding: 64px;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(10, 25, 47, 0.95));
    border-color: rgba(37, 99, 235, 0.3);
  }
  .ia-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 48px auto;
  }
  .ia-title {
    font-size: 3.5rem;
    margin-bottom: 16px;
    color: var(--text-main);
  }
  .ia-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
  }
  .agentes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-bottom: 48px;
  }
  .agente-item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }
  .agente-item:hover {
    background: rgba(37, 99, 235, 0.1);
    border-color: rgba(37, 99, 235, 0.3);
    transform: translateY(-4px);
  }
  .agente-header-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .agente-num {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--accent-gold);
    background: rgba(245, 158, 11, 0.15);
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .agente-icon {
    font-size: 2.2rem;
  }
  .agente-name {
    font-size: 1.5rem;
    margin-bottom: 8px;
    color: var(--text-main);
  }
  .agente-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .prompts-box {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 32px;
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
  }
  .prompts-icon {
    font-size: 3rem;
  }
  .prompts-title {
    font-size: 1.6rem;
    color: var(--accent-gold);
    margin-bottom: 8px;
  }
  .prompts-desc {
    color: var(--text-main);
    font-size: 0.95rem;
  }
  @media (max-width: 768px) {
    .ia-wrapper {
      padding: 32px 20px;
    }
    .ia-title {
      font-size: 2.6rem;
    }
    .prompts-box {
      flex-direction: column;
      text-align: center;
      padding: 24px;
    }
  }
</style>
