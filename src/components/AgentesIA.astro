---
<section class="ia-section section-padding" id="agentes-ia">
  <div class="container">
    <div class="ia-header">
      <div class="badge badge-gold">TECNOLOGIA EXCLUSIVA</div>
      <h2 class="ia-title">TENHA 11 ESPECIALISTAS DE I.A. À SUA DISPOSIÇÃO</h2>
      <p class="ia-subtitle">
        Prontos para pensar, analisar e responder como quem vive o consultório. O único ecossistema de inteligência artificial do Brasil exclusivo para nutricionistas.
      </p>
    </div>

    <!-- Mockup do Dashboard Nutri-Bots -->
    <div class="dashboard-mockup">
      <div class="mac-titlebar">
        <div class="mac-buttons">
          <span class="mac-btn close"></span>
          <span class="mac-btn minimize"></span>
          <span class="mac-btn expand"></span>
        </div>
        <div class="mac-title">app.nutribots.com/biblioteca</div>
      </div>

      <div class="dashboard-window">
        <!-- Top Navigation Bar (Blue) -->
        <div class="dashboard-topbar">
          <div class="topbar-left">
            <span class="sidebar-toggle">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="9" x2="9" y1="3" y2="21"/></svg>
            </span>
            <div class="brand-logo">
              <div class="brand-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="white" stroke="none"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm0 16a6 6 0 1 1 6-6 6 6 0 0 1-6 6Z"/></svg>
              </div>
              <span class="brand-name">Nutri-Bots</span>
            </div>
          </div>
        </div>

        <div class="dashboard-body">
          <!-- Sidebar -->
          <div class="dashboard-sidebar">
            <div class="sidebar-menu">
              <div class="menu-item active">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/><path d="M12 8V4"/><path d="M8 4h8"/></svg>
                <span>Agentes</span>
              </div>
              <div class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                <span>Prompts</span>
              </div>

              <div class="sidebar-btn-wrapper">
                <button class="btn-new-chat">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  <span>Nova Conversa</span>
                </button>
              </div>

              <div class="sidebar-search">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="Buscar nas conversas..." readonly />
              </div>

              <div class="sidebar-section">
                <div class="section-label">FAVORITOS</div>
                <div class="sub-item"><span class="star-icon">⭐</span> Story Cash</div>
                <div class="sub-item"><span class="star-icon">⭐</span> PBE: Interpretador de Evidên...</div>
                <div class="sub-item"><span class="star-icon">⭐</span> Exames 2.0</div>
              </div>

              <div class="sidebar-section">
                <div class="section-label">CONVERSAS</div>
                <div class="section-sublabel">ÚLTIMOS 7 DIAS</div>
                <div class="sub-item chat-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <span>stories para captar 3 paci...</span>
                </div>
                <div class="sub-item chat-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <span>Análise o hemograma do...</span>
                </div>
                <div class="sub-item chat-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <span>devo dar retorno nas min...</span>
                </div>
                <div class="sub-item chat-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <span>quero uma receita 3 ingr...</span>
                </div>
              </div>
            </div>

            <div class="sidebar-footer">
              <div class="footer-item">
                <div class="avatar-circle">D</div>
                <span>Perfil</span>
              </div>
              <div class="footer-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                <span>Conquistas</span>
              </div>
              <div class="footer-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
                <span>Novidades</span>
              </div>
              <div class="footer-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Admin</span>
              </div>
              <div class="footer-item logout">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                <span>Sair</span>
              </div>
            </div>
          </div>

          <!-- Main Dashboard Area -->
          <div class="dashboard-main">
            <div class="main-header">
              <h3 class="main-title">Biblioteca de Agentes</h3>
              <p class="main-subtitle">Escolha um agente para iniciar uma conversa</p>
            </div>

            <div class="filter-bar">
              <div class="search-box">
                <input type="text" placeholder="Pesquisar agentes..." readonly />
              </div>
              <div class="filter-tabs">
                <button class="filter-tab active">Todas</button>
                <button class="filter-tab">Marketing</button>
                <button class="filter-tab">Nutrição</button>
                <button class="filter-tab">Favoritos</button>
              </div>
            </div>

            <div class="bots-grid">
              {agentes.map(bot => (
                <div class="bot-card">
                  <div class="bot-card-top">
                    <div class="bot-icon-wrapper" style={`background-color: ${bot.iconBg}; color: ${bot.iconColor};`}>
                      <div set:html={bot.svg} />
                    </div>
                    <span class={`heart-btn ${bot.fav ? 'fav' : ''}`}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill={bot.fav ? "#EF4444" : "none"} stroke={bot.fav ? "#EF4444" : "#9CA3AF"} stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                    </span>
                  </div>

                  <div class="bot-card-body">
                    <h4 class="bot-title"><span class="star-icon">⭐</span> {bot.title}</h4>
                    <p class="bot-desc">{bot.desc}</p>
                    <span class="bot-tag">{bot.tag}</span>
                  </div>

                  <div class="bot-card-footer">
                    <span class="start-chat-text">Iniciar conversa</span>
                    <span class="start-chat-arrow">➔</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bônus Prompts -->
    <div class="prompts-box glass-panel">
      <div class="icon-box-premium icon-box-gold">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect width="20" height="5" x="2" y="7" rx="1"/><line x1="12" x2="12" y1="22" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
      </div>
      <div class="prompts-content">
        <h3 class="prompts-title">BÔNUS ESPECIAL: +50 PROMPTS DE ALTA CONVERSÃO E GESTÃO</h3>
        <p class="prompts-desc">
          Receba um acervo validado de prompts prontos para copiar e colar: Follow Up de pacientes, Prescrição Avançada, Marketing Ético, Contratos, Roteiros de Anamnese, Gestão de Consultório e Controle Financeiro.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .ia-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 56px auto;
  }
  .ia-title {
    font-size: 3.5rem;
    margin-bottom: 16px;
    color: var(--text-main);
  }
  .ia-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
  }

  /* --- MOCKUP DASHBOARD NUTRI-BOTS --- */
  .dashboard-mockup {
    background: #FFFFFF;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    margin-bottom: 64px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #1F2937;
  }

  /* Mac Titlebar */
  .mac-titlebar {
    background: #F3F4F6;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #E5E7EB;
  }
  .mac-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mac-btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .mac-btn.close { background: #EF4444; }
  .mac-btn.minimize { background: #F59E0B; }
  .mac-btn.expand { background: #10B981; }

  .mac-title {
    font-size: 0.85rem;
    color: #6B7280;
    font-weight: 500;
    margin: 0 auto;
    padding-right: 40px; /* balance buttons */
  }

  /* Dashboard Window */
  .dashboard-window {
    display: flex;
    flex-direction: column;
    background: #FAFAFA;
  }

  /* Topbar */
  .dashboard-topbar {
    background: #0C4A8E; /* Azul escuro Nutri-Bots */
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: white;
  }
  .topbar-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .sidebar-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
    opacity: 0.9;
  }
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand-icon {
    width: 28px;
    height: 28px;
    background: #1B7DFF;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  /* Dashboard Body */
  .dashboard-body {
    display: flex;
    min-height: 720px;
  }

  /* Sidebar */
  .dashboard-sidebar {
    width: 260px;
    background: #FFFFFF;
    border-right: 1px solid #E5E7EB;
