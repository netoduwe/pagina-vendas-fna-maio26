<style>
  .hero-section {
    position: relative;
    padding-top: 140px;
    padding-bottom: 60px;
    overflow: hidden;
    background:
      radial-gradient(circle at top center, rgba(0, 140, 255, 0.28), transparent 40%),
      linear-gradient(180deg, var(--color-bg-blue-dark) 0%, var(--color-bg-primary) 100%);
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
    margin-bottom: 80px;
  }
  .hero-badge-wrapper {
    margin-bottom: 24px;
  }
  .hero-badge-img {
    height: 38px;
    width: auto;
  }
  .hero-title {
    font-size: 3.4rem;
    line-height: 1.15;
    margin-bottom: 32px;
    letter-spacing: -0.5px;
    font-weight: 700;
  }
  .highlight-blue {
    color: #04DCFC;
    text-shadow: 0 0 20px rgba(4, 220, 252, 0.4);
  }
  .hero-bullets {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
  }
  .bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }
  .bullet-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .hero-btn {
    width: 100%;
    max-width: 440px;
    margin-bottom: 20px;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
  }
  .hero-guarantee {
    display: flex;
    gap: 28px;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .tag-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .svg-subtle {
    color: var(--color-accent-cyan);
  }

  /* Video & Floating Player Styles */
  .outer-video-placeholder {
    padding: 16px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 32px;
    width: 100%;
    aspect-ratio: 16 / 9;
    box-sizing: content-box;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 20px;
    background: #000;
    z-index: 10;
    box-shadow: inset 0 0 30px rgba(0,0,0,0.8);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Close Button (Only visible when floating) */
  .close-video-btn {
    position: absolute;
    top: -40px;
    right: 8px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10000;
    transition: all 0.3s ease;
    opacity: 0;
    pointer-events: none;
  }

  .close-video-btn:hover {
    background: var(--color-accent-cyan);
    color: #02070D;
    border-color: var(--color-accent-cyan);
    transform: scale(1.1);
  }

  /* Floating State */
  .video-wrapper.floating {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 360px;
    max-width: calc(100vw - 32px);
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(0, 217, 255, 0.3);
    z-index: 9999;
    background: #02070D;
    animation: float-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .video-wrapper.floating .close-video-btn {
    top: 8px;
    opacity: 1;
    pointer-events: auto;
  }

  @keyframes float-in {
    from { transform: translateY(20px) scale(0.95); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }

  /* Urgency Bar */
  .urgency-bar-wrapper {
    position: relative;
    z-index: 10;
    width: 100%;
  }
  .urgency-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 40px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(28px) saturate(190%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }
  .urgency-arrow {
    height: 48px;
    width: auto;
    flex-shrink: 0;
  }
  .urgency-items {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    flex-grow: 1;
  }
  .urgency-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 100px;
    font-size: 1.05rem;
    color: var(--color-text-primary);
  }
  .pill-icon {
    font-size: 1.2rem;
  }

  @media (max-width: 1200px) {
    .urgency-container {
      flex-direction: column;
      padding: 24px;
    }
    .urgency-arrow {
      display: none;
    }
    .urgency-items {
      flex-direction: column;
      width: 100%;
      align-items: stretch;
    }
    .urgency-pill {
      justify-content: center;
      text-align: center;
    }
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 56px;
    }
    .hero-badge-wrapper {
      display: flex;
      justify-content: center;
    }
    .hero-bullets {
      align-items: center;
      text-align: left;
    }
    .hero-guarantee {
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    .video-wrapper.floating {
      right: 12px;
      bottom: 12px;
      width: 260px;
    }
  }

  @media (max-width: 576px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-guarantee {
      flex-direction: column;
      gap: 12px;
    }
    .urgency-pill {
      font-size: 0.95rem;
      padding: 12px 16px;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const video = document.getElementById("video-wrapper");
  if (!video) return;

  const placeholder = video.closest(".outer-video-placeholder");
  const closeBtn = document.getElementById("close-floating-video");
  let isUserClosed = false;

  if (closeBtn) {
    closeBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      isUserClosed = true;
      video.classList.remove("floating");
    });
  }

  window.addEventListener("scroll", function () {
    if (isUserClosed || !placeholder) return;

    const rect = placeholder.getBoundingClientRect();
    const triggerPoint = window.scrollY + rect.top + rect.height;

    if (window.scrollY > triggerPoint) {
      video.classList.add("floating");
    } else {
      video.classList.remove("floating");
    }
  });
});
</script>
