      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 64px auto;
  }
  .section-title {
    font-size: 3.5rem;
    margin-bottom: 16px;
  }
  .highlight-blue {
    color: var(--accent-glow);
  }
  .section-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
  }
  .comparacao-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 32px;
    align-items: stretch;
    max-width: 1100px;
    margin: 0 auto;
  }
  .comp-card {
    border-radius: 24px;
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  /* --- CARD NORMAL --- */
  .normal-card {
    background: #0D1527; /* Azul Escuro Elegante */
    border: 1px solid rgba(255,255,255,0.08);
    color: #F8FAFC;
  }
  .normal-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .logo-na {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    line-height: 1;
    margin-bottom: 16px;
    letter-spacing: 1px;
  }
  .logo-nutricao {
    color: #94A3B8; /* Slate 400 */
    display: block;
    font-size: 1.6rem;
  }
  .logo-avancada {
    color: #38BDF8; /* Sky 400 vibrante */
    font-size: 2.6rem;
    font-weight: 700;
  }
  .normal-title {
    font-size: 2.4rem;
    font-family: var(--font-heading);
    color: #F8FAFC;
    margin-bottom: 20px;
  }
  .header-divider {
    height: 1px;
    background: rgba(255,255,255,0.15);
    width: 100%;
    margin: 0 auto;
  }
  .comp-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 1.05rem;
    margin-bottom: 40px;
  }
  .normal-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #E2E8F0;
  }
  .check-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: #22C55E; /* Green 500 */
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .normal-price-box {
    text-align: center;
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .price-main {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    color: #F8FAFC;
    margin-bottom: 4px;
  }
  .price-num {
    font-size: 3.8rem;
    font-weight: 700;
  }
  .price-sub {
    font-size: 1.1rem;
    color: #94A3B8;
    margin-bottom: 16px;
  }
  .price-footer {
    font-size: 0.95rem;
    color: #64748B;
    font-weight: 600;
  }

  /* --- CARD ESPECIAL (AMARELO) --- */
  .especial-card {
    background: #FACC15; /* Yellow 400 vibrante premium */
    color: #111827; /* Gray 900 para contraste máximo */
    border: 2px solid #EAB308;
    transform: scale(1.03);
    z-index: 2;
    box-shadow: 0 25px 50px rgba(234, 179, 8, 0.25);
  }
  .especial-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .especial-title {
    font-family: var(--font-heading);
    font-size: 3.2rem;
    color: #111827;
    margin-bottom: 16px;
    line-height: 1.1;
  }
  .discount-badge {
    background: #EF4444; /* Red 500 */
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.3rem;
    letter-spacing: 1px;
    padding: 6px 20px;
    border-radius: 8px;
    display: inline-block;
    margin-bottom: 24px;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
  }
  .especial-subtitle {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1F2937;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .check-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: #111827;
    color: #FACC15;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 50%;
  }
  .especial-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #111827;
    font-size: 1.05rem;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding-bottom: 10px;
  }
  .highlight-item {
    background: rgba(0, 0, 0, 0.06);
    padding: 12px 16px;
    border-radius: 12px;
    border-bottom: none !important;
    margin-bottom: 4px;
  }
  .svg-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .svg-star {
    color: #D97706; /* Amber 600 */
  }
  .svg-plus {
    color: #111827;
  }
  .especial-price-box {
    text-align: center;
    margin-top: auto;
    padding-top: 28px;
  }
  .old-price {
    font-size: 1.1rem;
    color: #DC2626; /* Red 600 */
    font-weight: 700;
    text-decoration: line-through;
    margin-bottom: 8px;
  }
  .new-price-main {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    color: #111827;
    margin-bottom: 4px;
    line-height: 1;
  }
  .new-price-num {
    font-size: 5rem;
    font-weight: 700;
  }
  .new-price-sub {
    font-size: 1.2rem;
    color: #374151;
    font-weight: 600;
    margin-bottom: 28px;
  }
  .btn-cta-especial {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, #06B6D4, #0284C7); /* Cyan to Sky Blue */
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.8rem;
    letter-spacing: 1px;
    padding: 22px;
    border-radius: 16px;
    text-decoration: none;
    box-shadow: 0 12px 24px rgba(2, 132, 199, 0.4);
    transition: all 0.3s ease;
    margin-bottom: 20px;
  }
  .btn-cta-especial:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(2, 132, 199, 0.6);
    background: linear-gradient(135deg, #0891B2, #0369A1);
  }
  .btn-arrow {
    margin-right: 8px;
  }
  .payment-icons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: 0.9rem;
    color: #4B5563;
    font-weight: 600;
  }
  .pay-tag {
    background: rgba(0,0,0,0.05);
    padding: 4px 12px;
    border-radius: 12px;
  }

  @media (max-width: 992px) {
    .comparacao-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .especial-card {
      transform: none;
    }
    .comp-card {
      padding: 36px 28px;
    }
  }
</style>
