---
const depoimentos = [
  { 
    name: "Berty Song", 
    role: "Nutricionista recém-formada", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-01.png",
    text: "Antes eu era muito insegura. A Nutrição Avançada mudou a minha vida, hoje em dia eu tenho mais pacientes e tenho mais tempo."
  },
  { 
    name: "Nair Cristina", 
    role: "Nutricionista há 4 anos", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-02.png",
    text: "Me sinto muito mais segura nas abordagens, eu pego um paciente e sei o que fazer com ele em todas as fases com total segurança."
  },
  { 
    name: "Nathalia Pantaleão", 
    role: "Nutricionista há 3 anos", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-03.png",
    text: "Tinha dificuldade para trabalhar com emagrecimento porque os pacientes não retornavam. Aplicava o que aprendi na faculdade, mas não gerava resultados. Hoje meus pacientes indicam meu trabalho!"
  },
  { 
    name: "João Marcelo", 
    role: "Aluno FNA", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2025/03/formacao-nutricao-avancada-resultados-depoimentos-joao.2.jpg",
    text: "Queria agradecer a todos que me incentivaram na mentoria a atender a paciente com ovário policístico que eu estava com medo. Acabamos de fechar o acompanhamento trimestral, no pix!"
  },
  { 
    name: "Aluna FNA", 
    role: "Nutricionista de Consultório", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/09/print-pacote-1k.jpg",
    text: "Fechei meu primeiro pacote de acompanhamento de R$ 1.000,00! A segurança clínica e o método da Formação foram essenciais para cobrar o valor justo."
  },
  { 
    name: "Nutricionista Avançada", 
    role: "Formada no final de 2023", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/09/curso-nutricao.jpg",
    text: "Me formei no final de 2023 e tinha muito medo de atender. O investimento na Formação se pagou rapidamente logo no início da minha prática clínica!"
  }
];
---
<section class="testimonials-section section-padding" id="depoimentos">
  <!-- SVG Background Curve (Bottom Right) -->
  <div class="bg-curve-wrapper">
    <svg
      class="bg-curve"
      fill="none"
      height="154"
      viewBox="0 0 460 154"
      width="460"
      xmlns="http://www.w3.org/2000/svg"
    >
      <g clip-path="url(#clip0_testimonials)">
        <path
          d="M-87.463 458.432C-102.118 348.092 -77.3418 238.841 -15.0744 188.274C57.4129 129.408 180.708 150.071 351.748 341.128C278.246 -374.233 633.954 380.602 548.123 42.7707"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="40"
        />
      </g>
      <defs>
        <clipPath id="clip0_testimonials">
          <rect fill="white" height="154" width="460" />
        </clipPath>
      </defs>
    </svg>
  </div>

  <div class="container relative z-10">
    <!-- Header -->
    <div class="section-header">
      <div class="icon-box-premium mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-star"><path d="M16.051 12.616a1 1 0 0 1 1.909.024l.737 1.452a1 1 0 0 0 .737.535l1.634.256a1 1 0 0 1 .588 1.806l-1.172 1.168a1 1 0 0 0-.282.866l.259 1.613a1 1 0 0 1-1.541 1.134l-1.465-.75a1 1 0 0 0-.912 0l-1.465.75a1 1 0 0 1-1.539-1.133l.258-1.613a1 1 0 0 0-.282-.866l-1.156-1.153a1 1 0 0 1 .572-1.822l1.633-.256a1 1 0 0 0 .737-.535z"/><path d="M8 15H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/></svg>
      </div>

      <h2 class="section-title relative">
        O QUE DIZEM OS <span class="highlight-cyan">NUTRICIONISTAS AVANÇADOS</span>
        <!-- SVG Underline Accent -->
        <svg
          class="title-accent"
          fill="currentColor"
          height="86"
          viewBox="0 0 108 86"
          width="108"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M38.8484 16.236L15 43.5793L78.2688 15L18.1218 71L93 34.1172L70.2047 65.2739"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="28"
          />
        </svg>
      </h2>
      <p class="section-subtitle">
        Histórias reais de profissionais que eliminaram a insegurança e transformaram seus consultórios com a metodologia do Ney Felipe.
      </p>
    </div>

    <!-- Marquee Track -->
    <div class="marquee-wrapper">
      <!-- Gradient Overlays for smooth edges -->
      <div class="marquee-overlay marquee-overlay-left"></div>
      <div class="marquee-overlay marquee-overlay-right"></div>

      <div class="marquee-track">
        <!-- Grupo 1 -->
        {depoimentos.map((member) => (
          <div class="testimonial-card group">
            <div class="card-inner">
              <div class="image-wrapper">
                <img
                  alt={member.name}
                  class="member-image"
                  src={member.image}
                  loading="lazy"
                />
                <div class="quote-badge">“</div>
              </div>
              <div class="content-wrapper">
                <p class="member-quote">"{member.text}"</p>
                <div class="member-info">
                  <h3 class="member-name">{member.name}</h3>
                  <p class="member-role">{member.role}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
        <!-- Grupo 2 (Clone para Loop Infinito) -->
        {depoimentos.map((member) => (
          <div class="testimonial-card group" aria-hidden="true">
            <div class="card-inner">
              <div class="image-wrapper">
                <img
                  alt={member.name}
                  class="member-image"
                  src={member.image}
                  loading="lazy"
                />
                <div class="quote-badge">“</div>
              </div>
              <div class="content-wrapper">
                <p class="member-quote">"{member.text}"</p>
                <div class="member-info">
                  <h3 class="member-name">{member.name}</h3>
                  <p class="member-role">{member.role}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Featured Bottom Testimonial / Quote -->
    <div class="featured-quote-container">
      <p class="featured-quote-text">
        "Nos primeiros atendimentos após a Formação pude me notar menos 'calculadora' e mais nutricionista, dando um novo significado e brilho nas minhas consultas."
      </p>
      <div class="featured-author">
        <div class="featured-avatar-wrapper">
          <img
            alt="Melissa Pinesso"
            class="featured-avatar"
            src="https://nutrineyfelipe.com/wp-content/uploads/2024/09/print-pacote-1k.jpg"
            loading="lazy"
          />
        </div>
        <div class="featured-author-info">
          <p class="featured-author-name">Melissa Pinesso</p>
          <p class="featured-author-role">Aluna & Especialista FNA</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-bg-primary);
    padding-top: 100px;
    padding-bottom: 120px;
  }

  /* SVG Background Curve */
  .bg-curve-wrapper {
    position: absolute;
    right: 0;
    bottom: 0;
    color: rgba(255, 255, 255, 0.03);
    pointer-events: none;
    z-index: 0;
  }

  .bg-curve {
    width: 460px;
    height: 154px;
  }

  /* Header */
  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 64px auto;
  }

  .icon-box-premium {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(0, 217, 255, 0.2), rgba(27, 125, 255, 0.2));
    border: 1px solid rgba(0, 217, 255, 0.4);
    color: var(--color-accent-cyan);
    box-shadow: 0 12px 24px rgba(0, 217, 255, 0.2);
  }

  .icon-star {
    width: 28px;
    height: 28px;
  }

  .section-title {
    font-size: 3.6rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--color-text-primary);
    display: inline-block;
  }

  .highlight-cyan {
    color: var(--color-accent-cyan);
    text-shadow: 0 0 25px rgba(0, 217, 255, 0.4);
  }

  .title-accent {
    position: absolute;
    top: -10px;
    right: -40px;
    width: 96px;
    height: 76px;
    color: rgba(255, 255, 255, 0.06);
    pointer-events: none;
    z-index: -1;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Marquee Wrapper */
  .marquee-wrapper {
    position: relative;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    margin-bottom: 80px;
    display: flex;
  }

  .marquee-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 5;
    pointer-events: none;
  }

  .marquee-overlay-left {
    left: 0;
    background: linear-gradient(to right, var(--color-bg-primary), transparent);
  }

  .marquee-overlay-right {
    right: 0;
    background: linear-gradient(to left, var(--color-bg-primary), transparent);
  }

  .marquee-track {
    display: flex;
    gap: 32px;
    width: max-content;
    animation: marquee-scroll 45s linear infinite;
    padding: 10px 0;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 16px)); }
  }

  /* Testimonial Card */
  .testimonial-card {
    width: 340px;
    flex-shrink: 0;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border-soft);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-medium);
    transition: all var(--motion-medium);
  }

  .card-inner:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(0, 217, 255, 0.3);
    box-shadow: var(--shadow-heavy);
    transform: translateY(-4px);
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #06111D;
  }

  .member-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(100%);
    transition: filter 0.5s ease, transform 0.5s ease;
  }

  .card-inner:hover .member-image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .quote-badge {
    position: absolute;
    bottom: 12px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-accent-cyan);
    color: #02070D;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 8px 16px rgba(0, 217, 255, 0.3);
  }

  .content-wrapper {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    gap: 20px;
  }

  .member-quote {
    font-size: 1.05rem;
    color: var(--color-text-primary);
    line-height: 1.6;
    font-style: italic;
  }

  .member-info {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 16px;
  }

  .member-name {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }

  .member-role {
    font-size: 0.9rem;
    color: var(--color-accent-cyan);
    font-weight: 600;
  }

  /* Featured Bottom Quote */
  .featured-quote-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 40px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    box-shadow: var(--shadow-medium);
    backdrop-filter: blur(20px);
  }

  .featured-quote-text {
    font-size: 1.45rem;
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.6;
    margin-bottom: 32px;
    font-style: italic;
  }

  .featured-author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .featured-avatar-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-accent-cyan);
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.3);
  }

  .featured-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-author-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 2px;
  }

  .featured-author-role {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .section-title { font-size: 2.6rem; }
    .testimonial-card { width: 300px; }
    .featured-quote-container { padding: 32px 24px; }
    .featured-quote-text { font-size: 1.2rem; }
  }
</style>
