---
const depoimentos = [
  // =========== VÍDEOS ===========
  {
    type: "video",
    title: "Fernanda Folle • Nutri há 12 anos",
    videoUrl: "https://www.youtube-nocookie.com/embed/K1O_x_HiYIo?rel=0&modestbranding=1",
    desc: "\"Encontrei na Formação um caminho prático para viver de consultório de forma leve e com total segurança nas prescrições.\""
  },
  {
    type: "video",
    title: "Adriana Guedes • Nutri há 17 anos",
    videoUrl: "https://www.youtube-nocookie.com/embed/I3q8K-Shdas?rel=0&modestbranding=1",
    desc: "\"Nenhuma pós-graduação que fiz na vida entrega tudo que a Formação Nutrição Avançada entregou. Incrível.\""
  },
  {
    type: "video",
    title: "Melissa Pinesso • Nutri & Aluna",
    videoUrl: "https://www.youtube-nocookie.com/embed/Zhi-YzQCIw8?rel=0&modestbranding=1",
    desc: "\"Nos primeiros atendimentos após o curso pude me notar menos 'calculadora' e mais nutricionista, dando um novo significado e brilho nas minhas consultas.\""
  },

  // =========== CITAÇÕES COM AVATAR CIRCULAR ===========
  { 
    type: "quote",
    name: "BERTY SONG", 
    role: "Nutricionista recém-formada", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-01.png",
    text: "Antes eu era muito insegura. A Nutrição Avançada mudou a minha vida, hoje em dia eu tenho mais pacientes e tenho mais tempo."
  },
  { 
    type: "quote",
    name: "NAIR CRISTINA", 
    role: "Nutricionista há 4 anos", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-02.png",
    text: "Me sinto muito mais segura nas abordagens, eu pego um paciente e sei o que fazer com ele em todas as fases com segurança."
  },
  { 
    type: "quote",
    name: "NATHALIA PANTALEÃO", 
    role: "Nutricionista há 3 anos", 
    image: "https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-03.png",
    text: "Tinha uma dificuldade para trabalhar com emagrecimento porque os pacientes não retornavam, eu aplicava tudo que tinha aprendido na faculdade, mas isso não gerava resultados. Hoje meus pacientes indicam meu trabalho."
  },

  // =========== PRINTS REAIS ===========
  {
    type: "print",
    title: "Nutricionista Recém-Formada",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/09/curso-nutricao.jpg",
    desc: "Formada no final de 2023, eliminou o medo de atender e recuperou o investimento da Formação rapidamente."
  },
  {
    type: "print",
    title: "Resultados de Consultório",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/05/compilado-comprimido.jpg",
    desc: "Compilado de alunos comemorando resultados reais, alta adesão dos pacientes e faturamento recorde."
  },
  {
    type: "print",
    title: "Segurança nas Prescrições",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/05/comprimido-site-1.jpg",
    desc: "Nutricionistas relatando a segurança clínica conquistada para conduzir casos difíceis e fidelizar pacientes."
  },
  {
    type: "print",
    title: "Evolução na Prática Clínica",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/05/compilado-comprimido-2.jpg",
    desc: "Alunos compartilhando a evolução no consultório e o impacto das prescrições avançadas no dia a dia."
  },
  {
    type: "print",
    title: "Comunidade Ativa",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/05/comprimido-site.jpg",
    desc: "Grupo exclusivo onde nutricionistas trocam experiências e celebram o crescimento contínuo do consultório."
  },
  {
    type: "print",
    title: "Plano Alimentar na Hora",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/09/curso-dieta-na-hora.jpg",
    desc: "Ganhou agilidade e segurança para entregar a dieta na hora, encantando e fidelizando pacientes."
  },
  {
    type: "print",
    title: "Autoridade e Reconhecimento",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/05/compilado-comprimido-3.jpg",
    desc: "Mais relatos de alunos que transformaram a insegurança em autoridade e reconhecimento profissional."
  },
  {
    type: "print",
    title: "Domínio das Ferramentas",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/05/enzo-print.jpg",
    desc: "Enzo comemorando o domínio das ferramentas e a clareza para aplicar a metodologia na prática diária."
  },
  {
    type: "print",
    title: "Aluna FNA • Consultório",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2024/09/print-pacote-1k.jpg",
    desc: "Fechou seu primeiro pacote de acompanhamento de R$ 1.000,00 aplicando a estrutura de valor da Formação."
  },
  {
    type: "print",
    title: "João Marcelo • Aluno FNA",
    image: "https://nutrineyfelipe.com/wp-content/uploads/2025/03/formacao-nutricao-avancada-resultados-depoimentos-joao.2.jpg",
    desc: "Superou a insegurança clínica com casos complexos (SOP) e fechou acompanhamento trimestral à vista no Pix."
  }
];
---
<section class="testimonials-section section-padding" id="depoimentos">
  <!-- SVG Background Curve (Bottom Right) -->
  <div class="bg-curve-wrapper">
    <svg
      class="bg-curve"
      fill="none"
      height="154"
      viewBox="0 0 460 154"
      width="460"
      xmlns="http://www.w3.org/2000/svg"
    >
      <g clip-path="url(#clip0_testimonials)">
        <path
          d="M-87.463 458.432C-102.118 348.092 -77.3418 238.841 -15.0744 188.274C57.4129 129.408 180.708 150.071 351.748 341.128C278.246 -374.233 633.954 380.602 548.123 42.7707"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="40"
        />
      </g>
      <defs>
        <clipPath id="clip0_testimonials">
          <rect fill="white" height="154" width="460" />
        </clipPath>
      </defs>
    </svg>
  </div>

  <div class="container relative z-10">
    <!-- Header -->
    <div class="section-header">
      <div class="icon-box-premium mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-star"><path d="M16.051 12.616a1 1 0 0 1 1.909.024l.737 1.452a1 1 0 0 0 .737.535l1.634.256a1 1 0 0 1 .588 1.806l-1.172 1.168a1 1 0 0 0-.282.866l.259 1.613a1 1 0 0 1-1.541 1.134l-1.465-.75a1 1 0 0 0-.912 0l-1.465.75a1 1 0 0 1-1.539-1.133l.258-1.613a1 1 0 0 0-.282-.866l-1.156-1.153a1 1 0 0 1 .572-1.822l1.633-.256a1 1 0 0 0 .737-.535z"/><path d="M8 15H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/></svg>
      </div>

      <h2 class="section-title relative">
        O QUE DIZEM OS <span class="highlight-cyan">NUTRICIONISTAS AVANÇADOS</span>
        <!-- SVG Underline Accent -->
        <svg
          class="title-accent"
          fill="currentColor"
          height="86"
          viewBox="0 0 108 86"
          width="108"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M38.8484 16.236L15 43.5793L78.268"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="28"
          />
        </svg>
      </h2>
      <p class="section-subtitle">
        Histórias reais de profissionais que eliminaram a insegurança e transformaram seus consultórios com a metodologia do Ney Felipe.
      </p>
    </div>

    <!-- Marquee Track -->
    <div class="marquee-wrapper">
      <div class="marquee-overlay marquee-overlay-left"></div>
      <div class="marquee-overlay marquee-overlay-right"></div>

      <div class="marquee-track">
        <!-- Grupo 1 -->
        {depoimentos.map((item) => (
          <div class={`testimonial-card card-type-${item.type} group`}>
            <div class="card-inner">
              {item.type === 'video' && (
                <>
                  <div class="slide-video-wrapper">
                    <iframe src={item.videoUrl} title={item.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                  </div>
                  <div class="slide-content">
                    <h4 class="slide-title">{item.title}</h4>
                    <p class="slide-desc">{item.desc}</p>
                  </div>
                </>
              )}
              {item.type === 'quote' && (
                <>
                  <div class="avatar-wrapper">
                    <img src={item.image} alt={item.name} loading="lazy" />
                  </div>
                  <h4 class="quote-author-name">{item.name}</h4>
                  <p class="quote-author-role">{item.role}</p>
                  <p class="quote-text">"{item.text}"</p>
                </>
              )}
              {item.type === 'print' && (
                <>
                  <div class="slide-img-wrapper">
                    <img src={item.image} alt={item.title} loading="lazy" />
                  </div>
                  <div class="slide-content">
                    <h4 class="slide-title">{item.title}</h4>
                    <p class="slide-desc">{item.desc}</p>
                  </div>
                </>
              )}
            </div>
          </div>
        ))}
        <!-- Grupo 2 (Clone para Loop Infinito) -->
        {depoimentos.map((item) => (
          <div class={`testimonial-card card-type-${item.type} group`} aria-hidden="true">
            <div class="card-inner">
              {item.type === 'video' && (
                <>
                  <div class="slide-video-wrapper">
                    <iframe src={item.videoUrl} title={item.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                  </div>
                  <div class="slide-content">
                    <h4 class="slide-title">{item.title}</h4>
                    <p class="slide-desc">{item.desc}</p>
                  </div>
                </>
              )}
              {item.type === 'quote' && (
                <>
                  <div class="avatar-wrapper">
                    <img src={item.image} alt={item.name} loading="lazy" />
                  </div>
                  <h4 class="quote-author-name">{item.name}</h4>
                  <p class="quote-author-role">{item.role}</p>
                  <p class="quote-text">"{item.text}"</p>
                </>
              )}
              {item.type === 'print' && (
                <>
                  <div class="slide-img-wrapper">
                    <img src={item.image} alt={item.title} loading="lazy" />
                  </div>
                  <div class="slide-content">
                    <h4 class="slide-title">{item.title}</h4>
                    <p class="slide-desc">{item.desc}</p>
                  </div>
                </>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Featured Bottom Testimonial / Quote -->
    <div class="featured-quote-container">
      <p class="featured-quote-text">
        "Nos primeiros atendimentos após a Formação pude me notar menos 'calculadora' e mais nutricionista, dando um novo significado e brilho nas minhas consultas."
      </p>
      <div class="featured-author">
        <div class="featured-avatar-wrapper">
          <img
            alt="Melissa Pinesso"
            class="featured-avatar"
            src="https://nutrineyfelipe.com/wp-content/uploads/2024/09/print-pacote-1k.jpg"
            loading="lazy"
          />
        </div>
        <div class="featured-author-info">
          <p class="featured-author-name">Melissa Pinesso</p>
          <p class="featured-author-role">Aluna & Especialista FNA</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-bg-primary);
    padding-top: 100px;
    padding-bottom: 120px;
  }

  /* SVG Background Curve */
  .bg-curve-wrapper {
    position: absolute;
    right: 0;
    bottom: 0;
    color: rgba(255, 255, 255, 0.03);
    pointer-events: none;
    z-index: 0;
  }

  .bg-curve {
    width: 460px;
    height: 154px;
  }

  /* Header */
  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 64px auto;
  }

  .icon-box-premium {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(0, 217, 255, 0.2), rgba(27, 125, 255, 0.2));
    border: 1px solid rgba(0, 217, 255, 0.4);
    color: var(--color-accent-cyan);
    box-shadow: 0 12px 24px rgba(0, 217, 255, 0.2);
  }

  .icon-star {
    width: 28px;
    height: 28px;
  }

  .section-title {
    font-size: 3.6rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--color-text-primary);
    display: inline-block;
  }

  .highlight-cyan {
    color: var(--color-accent-cyan);
    text-shadow: 0 0 25px rgba(0, 217, 255, 0.4);
  }

  .title-accent {
    position: absolute;
    top: -10px;
    right: -40px;
    width: 96px;
    height: 76px;
    color: rgba(255, 255, 255, 0.06);
    pointer-events: none;
    z-index: -1;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Marquee Wrapper */
  .marquee-wrapper {
    position: relative;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    margin-bottom: 80px;
    display: flex;
  }

  .marquee-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 5;
    pointer-events: none;
  }

  .marquee-overlay-left {
    left: 0;
    background: linear-gradient(to right, var(--color-bg-primary), transparent);
  }

  .marquee-overlay-right {
    right: 0;
    background: linear-gradient(to left, var(--color-bg-primary), transparent);
  }

  .marquee-track {
    display: flex;
    gap: 32px;
    width: max-content;
    animation: marquee-scroll 60s linear infinite;
    padding: 10px 0;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 16px)); }
  }

  /* Testimonial Card Base */
  .testimonial-card {
    width: 350px;
    flex-shrink: 0;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border-soft);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-medium);
    transition: all var(--motion-medium);
    justify-content: space-between;
  }

  .testimonial-card:hover .card-inner {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(0, 217, 255, 0.4);
    box-shadow: var(--shadow-heavy);
    transform: translateY(-6px);
  }

  /* =========== TIPO 1: VÍDEOS =========== */
  .slide-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .slide-video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* =========== TIPO 2: CITAÇÕES COM AVATAR CIRCULAR =========== */
  .card-type-quote .card-inner {
    padding: 32px 24px 24px 24px;
    background: linear-gradient(145deg, #06111D 0%, #02070D 100%);
    text-align: center;
    justify-content: flex-start;
  }

  .avatar-wrapper {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto 16px auto;
    border: 2px solid var(--color-accent-cyan);
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.3);
    flex-shrink: 0;
    background: #02070D;
  }

  .avatar-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .quote-author-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent-cyan);
    margin: 0 0 4px 0;
    letter-spacing: 0.5px;
  }

  .quote-author-role {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0 0 20px 0;
  }

  .quote-text {
    font-size: 1.05rem;
    color: var(--color-text-primary);
    line-height: 1.6;
    margin: 0;
    font-weight: 300;
    text-align: left;
  }

  /* =========== TIPO 3: PRINTS REAIS =========== */
  .slide-img-wrapper {
    width: 100%;
    height: 340px;
    background: #02070D;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .slide-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.5s ease;
  }

  .testimonial-card:hover .slide-img-wrapper img {
    transform: scale(1.05);
  }

  .slide-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    flex-grow: 1;
    justify-content: space-between;
  }

  .slide-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-accent-cyan);
    margin: 0;
    letter-spacing: -0.3px;
  }

  .slide-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
    font-weight: 400;
  }

  /* Featured Bottom Quote */
  .featured-quote-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 40px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    box-shadow: var(--shadow-medium);
    backdrop-filter: blur(20px);
  }

  .featured-quote-text {
    font-size: 1.45rem;
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.6;
    margin-bottom: 32px;
    font-style: italic;
  }

  .featured-author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .featured-avatar-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-accent-cyan);
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.3);
  }

  .featured-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-author-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 2px;
  }

  .featured-author-role {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .section-title { font-size: 2.6rem; }
    .testimonial-card { width: 300px; }
    .featured-quote-container { padding: 32px 24px; }
    .featured-quote-text { font-size: 1.2rem; }
  }
</style>
