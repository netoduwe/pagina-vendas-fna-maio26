---
const faqList = [
  { q: "Para quem é a Formação Nutrição Avançada?", a: "Para estudantes de nutrição e nutricionistas formados que desejam adquirir total segurança clínica, dominar a interpretação integrada de exames e alavancar o faturamento do consultório." },
  { q: "Como funciona a Biblioteca de Agentes de IA?", a: "Você terá acesso ao único sistema de I.A. do Brasil exclusivo para nutricionistas. São 11 agentes com curadoria clínica treinados na metodologia do Ney Felipe para analisar exames, artigos, dietas e te ajudar 24h por dia." },
  { q: "Por quanto tempo terei acesso ao curso?", a: "Você terá acesso completo por 2 anos (24 meses) à plataforma de aulas, gravações e atualizações da Formação." },
  { q: "Como funcionam as Mentorias e a Comunidade?", a: "Você terá mentorias mensais ao vivo no Zoom diretamente com o Ney Felipe e acesso à Tribo, nosso grupo VIP no WhatsApp com mais de 600 nutricionistas ativos trocando experiências diariamente." },
  { q: "E se eu não gostar da Formação?", a: "Você tem 7 dias de garantia incondicional. Se por qualquer motivo achar que a Formação não atende suas expectativas, devolvemos 100% do valor investido sem burocracia." },
  { q: "Quais são as formas de pagamento?", a: "Você pode parcelar em até 12x no cartão de crédito, pagar à vista via Pix com liberação imediata, ou via boleto bancário." }
];
---
<section class="faq-section section-padding" id="faq">
  <div class="container faq-container">
    <div class="section-header">
      <div class="badge">TIRA DÚVIDAS</div>
      <h2 class="section-title">PERGUNTAS <span class="text-glow highlight-blue">FREQUENTES</span></h2>
      <p class="section-subtitle">Encontre as respostas para as dúvidas mais comuns sobre a Formação Nutrição Avançada.</p>
    </div>

    <div class="faq-accordion">
      {faqList.map((item, index) => (
        <div class="glass-panel faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={`faq-answer-${index}`}>
            <span class="question-text">{item.q}</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="faq-answer" id={`faq-answer-${index}`}>
            <p>{item.a}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="faq-footer glass-panel">
      <h3>Ainda tem dúvidas? Fale com nosso suporte VIP</h3>
      <p>Nossa equipe está pronta para te atender no WhatsApp e tirar qualquer dúvida sobre a Formação.</p>
      <a href="https://api.whatsapp.com/send?phone=554791156389&text=Ol%C3%A1%20gostaria%20de%20tirar%20uma%20d%C3%BAvida%20sobre%20a%20Formação%20Nutrição%20na%20Avançada…" target="_blank" class="btn-shiny faq-btn">Chamar suporte no WhatsApp</a>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const faqButtons = document.querySelectorAll('.faq-question');

    faqButtons.forEach(button => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const answer = button.nextElementSibling;
        const icon = button.querySelector('.accordion-icon');

        faqButtons.forEach(btn => {
          btn.setAttribute('aria-expanded', 'false');
          btn.nextElementSibling.style.maxHeight = null;
          btn.querySelector('.accordion-icon').textContent = '+';
        });

        if (!isExpanded) {
          button.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + "px";
          icon.textContent = '−';
        }
      });
    });
  });
</script>

<style>
  .faq-container {
    max-width: 920px;
  }
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 64px auto;
  }
  .section-title {
    font-size: 3.5rem;
    margin-bottom: 16px;
  }
  .highlight-blue {
    color: var(--accent-glow);
  }
  .section-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
  }
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 64px;
  }
  .faq-item {
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 20px;
  }
  .faq-question {
    width: 100%;
    padding: 28px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border: none;
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .faq-question:hover {
    color: var(--accent-glow);
    background: rgba(255, 255, 255, 0.01);
  }
  .accordion-icon {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--accent-blue);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background: rgba(5, 11, 20, 0.4);
  }
  .faq-answer p {
    padding: 0 36px 28px 36px;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .faq-footer {
    padding: 56px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.15), rgba(5, 11, 20, 0.8));
    border-color: rgba(2, 132, 199, 0.3);
    box-shadow: 0 25px 50px rgba(0,0,0,0.5);
  }
  .faq-footer h3 {
    font-size: 2.2rem;
    color: var(--text-main);
  }
  .faq-footer p {
    color: var(--text-muted);
    margin-bottom: 12px;
    font-size: 1.1rem;
  }
  .faq-btn {
    font-size: 1.3rem;
    padding: 18px 36px;
  }
  @media (max-width: 768px) {
    .faq-question {
      padding: 24px 28px;
      font-size: 1.15rem;
    }
    .faq-answer p {
      padding: 0 28px 24px 28px;
    }
    .faq-footer {
      padding: 36px 24px;
    }
  }
</style>
