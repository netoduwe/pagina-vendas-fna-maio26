---
<section class="trilhas-section section-padding" id="trilhas">
  <div class="container">
    <div class="section-header">
      <div class="badge">CONTEÚDO PROGRAMÁTICO</div>
      <h2 class="section-title">AS <span class="text-glow highlight-blue">19 TRILHAS</span> DE APRENDIZAGEM</h2>
      <p class="section-subtitle">
        Uma formação de nível pós-graduação com mais de 124 horas de vídeo puro, estruturada para cobrir 100% dos desafios reais do consultório. Clique nas trilhas abaixo para explorar o conteúdo completo.
      </p>
    </div>

    <div class="trilhas-desktop trilhas-container glass-panel">
      <div class="trilhas-sidebar">
        {trilhas.map((trilha, index) => (
          <button 
            class={`trilha-tab ${index === 0 ? 'active' : ''}`} 
            data-target={`trilha-content-${trilha.id}`}
            aria-label={`Ver conteúdo da ${trilha.title}`}
          >
            <span class="trilha-tab-title">{trilha.title}</span>
          </button>
        ))}
      </div>

      <div class="trilhas-content-area">
        {trilhas.map((trilha, index) => (
          <div 
            class={`trilha-content-panel ${index === 0 ? 'active' : ''}`} 
            id={`trilha-content-${trilha.id}`}
          >
            <div class="panel-header">
              <div class="panel-header-left">
                <img src={trilha.img} alt={trilha.title} class="panel-trilha-img" />
                <h3 class="panel-title">{trilha.title}</h3>
              </div>
              <span class="panel-duration">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-inline"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {trilha.duration}
              </span>
            </div>
            <ul class="aulas-list">
              {trilha.aulas.map(aula => (
                <li class="aula-item">
                  <span class="aula-check">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="aula-name">{aula}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="trilhas-mobile faq-accordion">
      {trilhas.map((trilha) => (
        <div class="glass-panel faq-item trilha-accordion-item">
          <button class="faq-question trilha-accordion-header" aria-expanded="false" aria-controls={`mobile-trilha-content-${trilha.id}`}>
            <div class="header-info">
              <div class="mobile-header-top">
                <img src={trilha.img} alt={trilha.title} class="mobile-trilha-img" />
                <span class="question-text trilha-title">{trilha.title}</span>
              </div>
              <span class="trilha-duration-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-inline"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {trilha.duration}
              </span>
            </div>
            <span class="accordion-icon">+</span>
          </button>
          <div class="faq-answer trilha-accordion-content" id={`mobile-trilha-content-${trilha.id}`}>
            <div class="content-wrapper">
              <ul class="aulas-list-mobile">
                {trilha.aulas.map(aula => (
                  <li class="aula-item-mobile">
                    <span class="aula-check">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <span class="aula-name">{aula}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.trilha-tab');
    const panels = document.querySelectorAll('.trilha-content-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target');

        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        tab.classList.add('active');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });

    const mobileHeaders = document.querySelectorAll('.trilha-accordion-header');

    mobileHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        const content = header.nextElementSibling;
        const icon = header.querySelector('.accordion-icon');

        mobileHeaders.forEach(otherHeader => {
          otherHeader.setAttribute('aria-expanded', 'false');
          otherHeader.nextElementSibling.style.maxHeight = null;
          const otherIcon = otherHeader.querySelector('.accordion-icon');
          if (otherIcon) otherIcon.textContent = '+';
        });

        if (!isExpanded) {
          header.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + "px";
          if (icon) icon.textContent = '−';
        }
      });
    });
  });
</script>

<style>
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 64px auto;
  }
  .section-title {
    font-size: 3.5rem;
    margin-bottom: 16px;
  }
  .highlight-blue {
    color: var(--accent-glow);
  }
  .section-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
  }
  .trilhas-container {
    display: grid;
    grid-template-columns: 380px 1fr;
    min-height: 600px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
  }
  .trilhas-sidebar {
    border-right: 1px solid var(--border-color);
    background: rgba(5, 11, 20, 0.6);
    max-height: 700px;
    overflow-y: auto;
  }
  /* Custom Scrollbar for sidebar */
  .trilhas-sidebar::-webkit-scrollbar {
    width: 6px;
  }
  .trilhas-sidebar::-webkit-scrollbar-track {
    background: rgba(0,0,0,0.1);
  }
  .trilhas-sidebar::-webkit-scrollbar-thumb {
    background: var(--accent-blue);
    border-radius: 3px;
  }
  .trilha-tab {
    width: 100%;
    padding: 22px 28px;
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1.05rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .trilha-tab:hover {
    background: rgba(2, 132, 199, 0.1);
    color: var(--text-main);
  }
  .trilha-tab.active {
    background: rgba(2, 132, 199, 0.2);
    color: var(--accent-glow);
    border-left: 4px solid var(--accent-blue);
    font-weight: 600;
  }
  .trilhas-content-area {
    padding: 56px;
    max-height: 700px;
    overflow-y: auto;
    background: rgba(10, 19, 37, 0.3);
  }
  .trilhas-content-area::-webkit-scrollbar {
    width: 6px;
  }
  .trilhas-content-area::-webkit-scrollbar-track {
    background: rgba(0,0,0,0.1);
  }
  .trilhas-content-area::-webkit-scrollbar-thumb {
    background: var(--accent-blue);
    border-radius: 3px;
  }
  .trilha-content-panel {
    display: none;
  }
  .trilha-content-panel.active {
    display: block;
    animation: fadeIn 0.4s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-color);
  }
  .panel-header-left {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .panel-trilha-img {
    width: 80px;
    height: 80px;
    border-radius: 16px;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .panel-title {
    font-size: 2.2rem;
    color: var(--text-main);
  }
  .panel-duration {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    color: var(--accent-gold);
    background: rgba(250, 204, 21, 0.1);
    padding: 6px 16px;
    border-radius: 20px;
    border: 1px solid rgba(250, 204, 21, 0.25);
  }
  .svg-inline {
    flex-shrink: 0;
  }
  .aulas-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .aula-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
