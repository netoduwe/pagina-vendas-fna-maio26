---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ImpactQuote from '../components/ImpactQuote.astro';
import ProblemaSolucao from '../components/ProblemaSolucao.astro';
import Metodologia from '../components/Metodologia.astro';
import GrandesEntregas from '../components/GrandesEntregas.astro';
import AgentesIA from '../components/AgentesIA.astro';
import TrilhasGrid from '../components/TrilhasGrid.astro';
import CinematicIntermission from '../components/CinematicIntermission.astro';
import BonusSection from '../components/BonusSection.astro';
import ComparacaoOferta from '../components/ComparacaoOferta.astro';
import GarantiaSection from '../components/GarantiaSection.astro';
import Testimonials from '../components/Testimonials.astro';
import BioNey from '../components/BioNey.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Formação Nutrição Avançada (FNA T8) • Ney Felipe">
  <!-- Bloco Superior -->
  <main class="upper-main content-block">
    <Hero />
    <ImpactQuote />
    <ProblemaSolucao />
    <Metodologia />
    <GrandesEntregas />
    <AgentesIA />
    <TrilhasGrid />
  </main>

  <!-- Intermissão Cinematográfica (Curtain Reveal 1) -->
  <CinematicIntermission />

  <!-- Bloco Inferior -->
  <div class="lower-main content-block">
    <BonusSection />
    <ComparacaoOferta />
    <GarantiaSection />
    <Testimonials />
    <BioNey />
    <Faq />
  </div>

  <!-- Rodapé Cinematográfico (Curtain Reveal 2) -->
  <Footer />
</Layout>

<style>
  /* Garante que os blocos de conteúdo cubram as seções fixas de parallax até o final do scroll */
  .content-block {
    position: relative;
    z-index: 10;
    background-color: var(--color-bg-primary);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
</style>
