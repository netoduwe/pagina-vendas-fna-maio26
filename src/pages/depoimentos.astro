---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';

// Obter a lista de arquivos de depoimentos
const depoimentosDir = path.join(process.cwd(), 'public', 'depoimentos');
let files: string[] = [];

try {
  if (fs.existsSync(depoimentosDir)) {
    files = fs.readdirSync(depoimentosDir);
  }
} catch (e) {
  console.error("Erro ao ler diretório de depoimentos:", e);
}

// Separar vídeos e imagens
const validImageExts = ['.jpg', '.jpeg', '.png', '.webp', '.gif'];
const validVideoExts = ['.mp4', '.mov', '.webm'];

const imagens = files.filter(f => {
  const ext = path.extname(f).toLowerCase();
  return validImageExts.includes(ext);
});

const videos = files.filter(f => {
  const ext = path.extname(f).toLowerCase();
  return validVideoExts.includes(ext);
});

---

<Layout title="Depoimentos FNA - Formação Nutrição Avançada">
  <main class="depoimentos-page">
    <div class="header-section">
      <div class="logo-wrapper">
        <span class="badge">Resultados Reais</span>
        <h1>O que dizem nossos alunos</h1>
        <p>Veja os resultados reais de quem já aplicou o método da Formação Nutrição Avançada no consultório.</p>
        <a href="/" class="back-link">← Voltar para a página oficial</a>
      </div>
    </div>

    <section class="gallery-section">
      {videos.length > 0 && (
        <div class="category-block">
          <h2>Vídeos de Alunos</h2>
          <div class="video-grid">
            {videos.map(video => (
              <div class="media-card video-card glass-panel">
                <video controls preload="metadata">
                  <source src={`/depoimentos/${video}`} type={`video/${path.extname(video).substring(1).replace('mov', 'mp4')}`} />
                  Seu navegador não suporta a tag de vídeo.
                </video>
              </div>
            ))}
          </div>
        </div>
      )}

      {imagens.length > 0 && (
        <div class="category-block">
          <h2>Resultados em Prints</h2>
          <div class="masonry-grid">
            {imagens.map(img => (
              <div class="media-card image-card glass-panel">
                <img src={`/depoimentos/${img}`} alt="Depoimento FNA" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      )}
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .depoimentos-page {
    background-color: var(--color-bg-primary);
    min-height: 100vh;
    padding-top: 80px;
    padding-bottom: 80px;
    position: relative;
    z-index: 10;
  }

  .header-section {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 60px;
    padding: 0 20px;
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(37, 99, 235, 0.1);
    color: #3b82f6;
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 24px;
  }

  h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1;
    color: var(--color-text-primary);
    margin-bottom: 20px;
  }

  p {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    margin-bottom: 30px;
  }

  .back-link {
    display: inline-block;
    color: #3b82f6;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: #60a5fa;
    transform: translateX(-5px);
  }

  .gallery-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .category-block {
    margin-bottom: 80px;
  }

  h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem;
    color: var(--color-text-primary);
    margin-bottom: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 15px;
  }

  /* Estilos do Painel de Vidro */
  .glass-panel {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(20px) saturate(190%);
    -webkit-backdrop-filter: blur(20px) saturate(190%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .glass-panel:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Grid de Vídeos */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
  }

  .video-card video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 9/16;
    display: block;
  }

  /* Grid Masonry para Imagens */
  .masonry-grid {
    column-count: 3;
    column-gap: 30px;
  }

  .image-card {
    display: inline-block;
    width: 100%;
    margin-bottom: 30px;
  }

  .image-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Responsividade Masonry */
  @media (max-width: 1024px) {
    .masonry-grid {
      column-count: 2;
    }
  }

  @media (max-width: 640px) {
    .masonry-grid {
      column-count: 1;
    }
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
